    "@hocuspocus/extension-database": "^2.15.0",
    "@hocuspocus/provider": "^2.15.3",
    "@hocuspocus/server": "^2.15.0",
    "compression": "^1.7.5",
    "express": "^4.21.2",
    "express-ws": "^5.0.2",
    "html-to-image": "^1.11.13",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.20"
