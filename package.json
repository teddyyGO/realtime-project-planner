{
  "name": "project-planning-tree",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Real-time multi-user project planning: React Flow tree maker and kanban boards, synced with Yjs + Hocuspocus and persisted to Postgres.",
